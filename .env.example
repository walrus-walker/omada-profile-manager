# =============================================================================
# Net Profile Manager — Environment Configuration
# =============================================================================
# Copy this file to .env.desktop and fill in your real values:
#   cp .env.example .env.desktop
#   nano .env.desktop
#   ./scripts/apply-env.sh desktop
#
# These Omada values come from:
#   Global View -> Settings -> Platform Integration -> Open API
# =============================================================================

# --- Omada Open API Credentials ---

# The local URL of your Omada Controller (no trailing slash)
# Example: https://192.168.1.10:8043
OMADA_BASE_URL=https://192.168.1.10:8043

# The Omada Controller ID (also called Omada ID)
# Found on the Open API page in the Omada Controller web UI
OMADA_CONTROLLER_ID=your-omada-controller-id

# The Client ID generated by Omada for your Open API application
OMADA_CLIENT_ID=your-omada-client-id

# The Client Secret generated by Omada for your Open API application
OMADA_CLIENT_SECRET=your-omada-client-secret

# The Site ID that this app will manage
# Found in Omada under Site Management, or via the List Sites API call
OMADA_SITE_ID=your-omada-site-id

# Whether to verify the Omada Controller TLS certificate
# Set to false if using a self-signed certificate (common in homelabs)
OMADA_VERIFY_SSL=false

# Omada Controller admin credentials — required for block/unblock
# These are your Omada web UI login (not the Open API client credentials)
OMADA_UI_USERNAME=admin
OMADA_UI_PASSWORD=your-omada-admin-password

# --- App Settings ---

# Host and port for the web app inside the container
APP_HOST=0.0.0.0
APP_PORT=8095

# PIN used to unlock the web UI
# Change this to something only you know
APP_ADMIN_PIN=change-this

# Secret key used to sign session cookies
# Use a long random string — generate with: openssl rand -hex 32
APP_SECRET_KEY=change-this-to-a-long-random-string

# Path to the SQLite database file inside the container
DATABASE_PATH=/data/net-profile-manager.db

# --- Optional ---

# Discord webhook URL for optional notifications (leave empty to disable)
DISCORD_WEBHOOK_URL=
